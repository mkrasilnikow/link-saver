# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here
ALLOWED_USER_ID=your_telegram_user_id_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Google Sheets (data storage)
# 1. Create a Google Cloud project, enable the Google Sheets API
# 2. Create a service account, download its JSON key
# 3. Create a Google Sheet, share it (Editor) with the service account email
# 4. Base64-encode the JSON key:  base64 -w0 service-account.json
#    and paste the result below (single line). Raw JSON also works.
GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json_here
# The sheet ID is the long string in its URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# YouTube (optional but recommended)
YOUTUBE_API_KEY=your_youtube_api_key_here

# UI Auth — password-protect the web interface
AUTH_PASSWORD=choose-a-strong-password
AUTH_SECRET=run-openssl-rand-hex-32-and-paste-here
